# ---- Client (Vite) ----
# Safe to expose; the anon key is protected by Row Level Security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ---- Supabase Edge Functions (set via `supabase secrets set`) ----
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.
CLIP_SERVICE_URL=https://<user>-<space>.hf.space
CLIP_SERVICE_SECRET=<shared-secret-also-set-on-the-space>

# ---- CLIP service (Hugging Face Space secret) ----
# Must match CLIP_SERVICE_SECRET above.
# CLIP_SERVICE_SECRET=<shared-secret>
